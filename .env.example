# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Domain frontend yang diizinkan CORS. WAJIB diganti saat deploy produksi,
# kalau tidak semua request dari domain asli akan ditolak.
CLIENT_ORIGIN=http://localhost:3000

# ── Firebase Admin SDK ─────────────────────────────────────────────────
# Unduh dari Firebase Console > Project Settings > Service accounts.
# File ini memberi akses PENUH ke database. JANGAN pernah commit ke Git.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── Pajak ──────────────────────────────────────────────────────────────
DEFAULT_TAX_RATE=0.11

# ── Pembayaran QRIS ────────────────────────────────────────────────────
# Ada tiga kemungkinan, dan aplikasi akan MENYATAKAN yang mana sedang aktif
# di halaman Pengaturan. Tidak ada mode yang memalsukan kode QR.
#
# 1) TERVERIFIKASI — isi MIDTRANS_SERVER_KEY.
#    QRIS dinamis: nominal terkunci, status pembayaran dicek otomatis ke
#    Midtrans, dan transaksi baru bisa disimpan setelah gateway bilang lunas.
#    Ambil kuncinya di dashboard.midtrans.com > Settings > Access Keys.
#    Mulai dari sandbox (kunci berawalan SB-Mid-server-) sebelum produksi.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# 2) MANUAL — isi MERCHANT_QRIS_PAYLOAD dengan teks QRIS statis milik toko
#    (string panjang berawalan 00020101...). Uang benar-benar masuk ke
#    rekening toko, TETAPI nominal tidak terkunci dan sistem tidak bisa tahu
#    sudah dibayar atau belum. Kasir wajib mengecek mutasi.
MERCHANT_QRIS_PAYLOAD=

# 3) NONAKTIF — biarkan keduanya kosong. Tombol QRIS akan menolak dengan
#    penjelasan, bukan menampilkan QR hiasan yang menyesatkan.

# ── Pesanan online (M11) ───────────────────────────────────────────────
# Batas waktu membayar. Lewat ini stok dikembalikan ke rak otomatis.
ORDER_EXPIRY_MINUTES=60

# ── Ongkos kirim (M13) ─────────────────────────────────────────────────
# Tarif per zona. Ambil sendiri di toko selalu gratis.
ONGKIR_DALAM_KOTA=10000
ONGKIR_LUAR_KOTA=25000
