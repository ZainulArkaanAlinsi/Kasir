rules_version = '2';

/**
 * Security Rules KasirOne.
 *
 * Prinsip utama: KLIEN TIDAK PERNAH MENULIS data uang atau stok.
 * Koleksi products / transactions / expenses / auditLogs hanya boleh ditulis
 * lewat Admin SDK di server (yang melewati rules ini sepenuhnya), setelah
 * divalidasi dan dijalankan dalam Firestore transaction.
 * Browser hanya diberi izin MEMBACA, supaya listener real-time tetap bisa
 * dipakai tanpa membuka celah manipulasi harga/stok.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Role dibaca dari custom claim lebih dulu (tidak perlu extra read),
    // lalu jatuh balik ke dokumen users/{uid} untuk akun lama.
    function roleOf() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && roleOf() == 'admin';
    }

    function isStaff() {
      return signedIn() && roleOf() in ['admin', 'cashier'];
    }

    function isCustomer() {
      return signedIn() && roleOf() == 'customer';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Pengguna boleh membuat profilnya sendiri, TAPI hanya sebagai
      // 'customer' — satu-satunya peran yang memang tanpa hak istimewa.
      //
      // 'cashier' dulu ikut di daftar ini dan itu adalah lubang: apiKey di
      // frontend memang publik dan pendaftaran Email/Password terbuka, jadi
      // orang asing selalu bisa memperoleh token yang sah. Tokennya tidak
      // punya custom claim, sehingga roleOf() jatuh balik membaca dokumen
      // users/{uid} — dokumen yang baru saja ia tulis sendiri. Dengan menulis
      // 'cashier' di situ, ia lolos isStaff() dan harga modal serta seluruh
      // riwayat transaksi toko terbuka untuknya.
      //
      // Akun staf tidak pernah lahir dari sini. Ia dibuat lewat Admin SDK
      // (scripts/buat-akun.js), yang melewati rules ini sepenuhnya.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'customer';

      // Pengguna boleh mengubah namanya sendiri, tapi TIDAK boleh menyentuh
      // role-nya. Kenaikan role hanya lewat admin atau server.
      allow update: if isAdmin()
                    || (signedIn()
                        && request.auth.uid == uid
                        && request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    // Master produk: staf membacanya untuk grid kasir, pelanggan untuk
    // etalase. Harga modal memang ikut terbaca pelanggan di sini, karena
    // Firestore tidak bisa menyembunyikan sebagian field — itulah sebabnya
    // etalase mengambil produk lewat API server yang menyaring field, bukan
    // lewat SDK langsung. Penulisan tetap tertutup untuk semua klien.
    match /products/{productId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Pesanan online. Pelanggan hanya boleh melihat miliknya sendiri;
    // pembuatan dan perubahan status wajib lewat server agar stok terkunci
    // secara atomik dan perpindahan status tetap sah.
    match /orders/{orderId} {
      allow read: if isStaff()
                  || (isCustomer() && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    // Transaksi: staf boleh baca riwayat; pembuatan HARUS lewat
    // POST /api/transactions agar stok terkunci atomik.
    match /transactions/{transactionId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Pengeluaran & modal toko: hanya admin yang boleh melihat.
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Audit log: hanya admin yang boleh membaca, tidak ada yang boleh
    // mengubah atau menghapus — termasuk admin.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
